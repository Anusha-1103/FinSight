# FinSight AI Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://finsight_user:finsight_password@localhost:5432/finsight_db?schema=public"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# Security JWT Secrets (At least 32 characters long)
JWT_SECRET="finsight_super_secret_access_token_key_2026_production"
REFRESH_TOKEN_SECRET="finsight_super_secret_refresh_token_key_2026_production"

# External Integrations (Optional)
GEMINI_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
