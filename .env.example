# FinSight AI Root Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
DATABASE_URL="postgresql://finsight_user:finsight_password@localhost:5432/finsight_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET="finsight_super_secret_access_token_key_2026_production"
REFRESH_TOKEN_SECRET="finsight_super_secret_refresh_token_key_2026_production"

# External Integrations (Optional)
GEMINI_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
